/* 客户端和管理端共用浅色主题。 */
QWidget#appCentral {
    background: transparent;
}
QStackedWidget#contentStack { background: transparent; }
QWidget#sidebar {
    background: #DDF2E5; border: 1px solid #B9DCC6; border-radius: 22px;
}
QWidget#sidebar[sidebarExpanded="true"] {
    background: #D6EEDF; border-color: #99C7AB;
}
QWidget#logoBox { background: transparent; border: none; margin: 8px 6px; }
QLabel#logoLabel { color: #1E5E43; font-size: 18px; }
QListWidget#navList { color: #5D7167; padding: 4px; background: transparent; }
QListWidget#navList::item {
    border: 1px solid transparent; border-radius: 12px;
    padding: 12px 10px; margin: 4px 7px;
}
QListWidget#navList::item:selected {
    background: #E2F3E8; color: #16814F; border: 1px solid #C8E5D3;
}
QListWidget#navList::item:hover {
    background: #EAF7EF; color: #16814F; border: 1px solid #B8DDC7;
}
QLabel#sideNote { color: #71877B; font-size: 12px; padding: 14px 18px; }
QPushButton#logoutBtn {
    color: #5D7167; background: transparent; border: 1px solid transparent;
    border-radius: 12px; margin: 0px 7px; padding: 10px;
}
QPushButton#logoutBtn:hover { color: #16814F; background: #EAF7EF; border-color: #B8DDC7; }
QWidget#headerBar { background: #FFFFFF; border-bottom: 1px solid #E3ECE7; }
QLabel#headerTitle { color: #173E33; font-size: 15px; }
QLabel#headerUser { background: #F0F7F3; color: #416254; border: none; padding: 4px 11px; }
QLabel#pageTitle { color: #173E33; }
QLabel#pageHint { color: #667C73; }
QFrame#discoveryHero { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #164D40,stop:1 #28715B); border-radius: 18px; }
QLabel#heroEyebrow { color: #AAD6C1; font-size: 10px; letter-spacing: 2px; background: transparent; }
QLabel#heroTitle { color: #F6FFF5; font-size: 28px; font-weight: 700; background: transparent; }
QLabel#heroSubtitle { color: #D3ECDD; font-size: 13px; background: transparent; }
QLabel#heroArt { background: transparent; padding: 0px 12px; }
QLabel#discoverySummary { color: #2E6852; background: #E6F1E9; border-radius: 9px; padding: 11px 16px; }
QWidget#stationCardHost, QWidget#chargingCardHost, QScrollArea { background: transparent; border: none; }
QFrame#stationCard { background: white; border: 1px solid #DFEAE4; border-radius: 14px; }
QFrame#stationCard:hover { border: 1px solid #6DA98B; background: #FDFFFD; }
QLabel#stationName { color: #193F33; font-size: 17px; font-weight: 700; }
QLabel#stationPrice { color: #197451; font-size: 19px; font-weight: 700; }
QLabel#availableBadge { color: #196B4A; background: #E5F6EB; border-radius: 6px; padding: 5px 10px; font-weight: 600; }
QLabel#busyBadge { color: #986522; background: #FFF2DB; border-radius: 6px; padding: 5px 10px; }
QLabel#emptyState { color: #73847B; background: white; border-radius: 12px; padding: 24px; }
QPushButton { border: 1px solid #D2E1D8; border-radius: 8px; color: #395F4D; padding: 7px 14px; }
QPushButton:hover, QPushButton#secondaryBtn:hover { background: #ECF6EF; border-color: #7CAD90; color: #195C3D; }
QPushButton:pressed { background: #DCEFE1; }
QPushButton#primaryBtn, QPushButton#searchButton, QPushButton#successBtn { background: #237653; color: white; border: 1px solid #237653; }
QPushButton#primaryBtn:hover, QPushButton#searchButton:hover, QPushButton#successBtn:hover { background: #195E42; border-color: #195E42; }
QLineEdit#chargingStationSearch {
    min-height: 24px; padding: 8px 13px; border-radius: 10px;
    background: #FFFFFF; border: 1px solid #CFE0D6;
}
QLineEdit#chargingStationSearch:focus { border: 2px solid #63A27E; padding: 7px 12px; }
QPushButton#chargingStationSearchButton {
    min-height: 24px; padding: 8px 20px; border-radius: 10px;
    color: #FFFFFF; background: #237653; border: 1px solid #195E42; font-weight: 700;
}
QPushButton#chargingStationSearchButton:hover { background: #195E42; }
QPushButton#primaryBtn:disabled, QPushButton:disabled { background: #EDF1ED; color: #94A298; border: 1px solid #E1E8E2; }
QPushButton:focus { border: 2px solid #70B18C; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit { border: 1px solid #D3E0D8; selection-background-color: #237653; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus { border: 2px solid #4E9870; }
QLineEdit:hover, QComboBox:hover { border-color: #7CAD90; }
QComboBox QAbstractItemView { selection-background-color: #E2F3E7; selection-color: #18573A; }
QCheckBox::indicator:checked { background: #237653; border-color: #237653; }
QTableWidget, QTableView { selection-background-color: #E6F3EA; selection-color: #245E3E; gridline-color: #EDF3EF; }
QTableWidget::item:hover { background: #F0F8F2; }
QHeaderView::section { background: #EDF4EF; color: #4B6858; }
QScrollArea#stationCardsScroll, QWidget#stationManageCardHost {
    background: transparent; border: none;
}
QPushButton#stationManageCard {
    background: #FFFFFF; border: 1px solid #D8E6DE; border-radius: 15px;
    padding: 0px; text-align: left;
    min-width: 246px; max-width: 246px; min-height: 120px; max-height: 120px;
}
QPushButton#stationManageCard:hover {
    background: #FBFEFC; border: 1px solid #7FB696;
}
QPushButton#stationManageCard:checked {
    background: #F0F8F3; border: 2px solid #2D8B60;
}
QPushButton#stationManageCard QLabel { background: transparent; border: none; }
QLabel#stationCardName { color: #173F31; font-size: 15px; font-weight: 750; }
QLabel#stationCardAddress { color: #75877D; font-size: 10px; }
QLabel#stationCardStats { color: #3E6B55; font-size: 11px; font-weight: 600; }
QProgressBar#stationCardOccupancy {
    color: #356A50; background: #E8F0EB; border: none; border-radius: 6px;
    min-height: 13px; max-height: 13px; text-align: center; font-size: 9px;
}
QProgressBar#stationCardOccupancy::chunk { background: #A7D7BA; border-radius: 6px; }
QLabel#stationOccupancyCaption { color: #6D8176; font-size: 12px; }
QProgressBar#stationOccupancyBar {
    color: #245978; background: #EDF3F7; border: 1px solid #D8E5EC;
    border-radius: 9px; min-height: 18px; text-align: center; font-size: 10px; font-weight: 700;
}
QProgressBar#stationOccupancyBar::chunk {
    background: #AFCFF3; border-radius: 8px;
}
QScrollBar:vertical { background: #ECF2EE; width: 7px; border: none; margin: 0px; }
QScrollBar::handle:vertical { background: #B5CDBE; min-height: 32px; border-radius: 3px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }

QMainWindow, QDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                stop:0 #8EA487, stop:0.17 #FFFFFF, stop:0.43 #DDD5B9,
                stop:0.68 #FFFFFF, stop:1 #5E8A58);
    color: #243E33;
}
QStackedWidget, QScrollArea, QTabWidget::pane { background: transparent; color: #243E33; }
QAbstractScrollArea::corner { background: transparent; border: none; }
QTableWidget, QTableView, QListWidget, QTextEdit {
    background: #FFFFFF; alternate-background-color: #F1F7F3; color: #243E33;
}
QHeaderView, QHeaderView::section, QTableCornerButton::section { background: #EDF4EF; color: #4B6858; }
QTabWidget::pane { border: 1px solid #DCE8DF; border-radius: 8px; }
QTabBar::tab { background: #EAF1EC; color: #5C7466; padding: 10px 18px; border: none; }
QTabBar::tab:selected { background: #FFFFFF; color: #237653; border-bottom: 3px solid #237653; }
QTabBar::tab:hover { background: #E0F0E5; }
QToolTip { background: #FFFFFF; color: #243E33; border: 1px solid #B5CDBE; }
QDateEdit, QDateTimeEdit, QTimeEdit { background: #FFFFFF; color: #243E33; border: 1px solid #D3E0D8; border-radius: 6px; padding: 7px; }
QStatusBar { background: rgba(255,255,255,205); color: #4C6257; }

/* 搜索框与下拉框固定展开，始终显示提示或当前选项文字。 */
QLineEdit[compactFieldInstalled="true"], QComboBox[compactFieldInstalled="true"] {
    min-height: 24px; border-radius: 10px; background: rgba(255,255,255,235);
}
QLineEdit[compactExpanded="true"], QComboBox[compactExpanded="true"] {
    color: #243E33; background: #FFFFFF; border-color: #6E9F7D;
}

/* 首页：参照网页模板的信息型 Bento，卡片内部直接展示业务摘要。 */
QWidget#homePage { background: transparent; }
QWidget#messagePage, QWidget#accountPage, QWidget#chargingPage,
QWidget#chargingSelectView, QWidget#chargingActiveView, QWidget#chargingWaitingView,
QScrollArea[pageScroller="true"], QScrollArea[pageScroller="true"] QWidget#qt_scrollarea_viewport {
    background: transparent; border: none;
}
QLabel#homeGreeting { color: #33424E; font-size: 25px; font-weight: 750; }
QLabel#homeIntro { color: #758693; font-size: 13px; }
QPushButton#homeRefreshButton {
    color: #456E87; background: #FFFFFF; border: 1px solid #CEDBE3;
    border-radius: 10px; padding: 8px 16px; font-weight: 650;
}
QPushButton#homeRefreshButton:hover { color: #345F79; background: #F4F8FA; border-color: #7598AD; }
QFrame#homeMapCard {
    background: #FFFFFF; border: 1px solid #D4E2DF; border-radius: 20px;
}
QFrame#homeMapCard QLabel { background: transparent; border: none; }
QLabel#homeMapIcon {
    background: #E5F1ED; border: 1px solid #CFE2DB; border-radius: 12px;
}
QLabel#homeMapTitle { color: #2F4546; font-size: 17px; font-weight: 750; }
QLabel#homeMapSubtitle { color: #82928F; font-size: 11px; }
QLabel#homeMapBadge {
    color: #367363; background: #E5F3ED; border: 1px solid #CCE4D9;
    border-radius: 10px; padding: 5px 9px; font-size: 10px; font-weight: 700;
}
QPushButton#homeMapAction {
    color: #426F68; background: #F5F9F8; border: 1px solid #D4E3DF;
    border-radius: 9px; padding: 7px 11px; font-size: 11px; font-weight: 700;
}
QPushButton#homeMapAction:hover { color: #245D50; background: #EAF4F0; border-color: #8EB5AA; }
QWidget#homeMapCanvas { background: #E8F0EE; border: 1px solid #D8E4E1; border-radius: 14px; }
QPushButton#bentoCard {
    padding: 0px; text-align: left; outline: none;
    background: #FFFFFF; border: 1px solid #D7E1E7; border-radius: 20px;
}
QPushButton#bentoCard:hover { border: 1px solid #D7E1E7; background: #FFFFFF; }
QPushButton#bentoCard:pressed { border: 2px solid #5B87A3; background: #F1F6F8; }
QPushButton#bentoCard QLabel { background: transparent; border: none; }
QPushButton#bentoCard QLabel#bentoIcon {
    background: #E7F0F5; border: 1px solid #D2E2EB; border-radius: 13px;
}
QPushButton#bentoCard QLabel#bentoTitle { color: #33424E; font-size: 17px; font-weight: 700; }
QPushButton#bentoCard QLabel#bentoDescription { color: #8B9BA7; font-size: 11px; }
QPushButton#bentoCard QLabel#bentoAction { color: #456F89; font-size: 12px; font-weight: 700; }
QPushButton#bentoCard QLabel#homeBadge {
    color: #456F89; background: #DFEBF1; border: 1px solid #CBDDE7;
    border-radius: 10px; padding: 5px 9px; font-size: 10px; font-weight: 700;
}
QPushButton#bentoCard QLabel#homeEndpoint {
    color: #3F6E8C; font-size: 19px; font-weight: 750; letter-spacing: 1px;
}
QPushButton#bentoCard QLabel#homeEndpointInline {
    color: #688078; font-size: 10px; padding: 1px 2px;
}
QPushButton#bentoCard QLabel#homeBalance { color: #3F6E8C; font-size: 30px; font-weight: 750; }
QPushButton#bentoCard QLabel#homePowerValue { color: #237A62; font-size: 23px; font-weight: 800; }
QPushButton#bentoCard QLabel#homePowerHint { color: #7A9089; font-size: 10px; }
QPushButton#bentoCard QLabel#homeFeatureTitle { color: #41515D; font-size: 14px; font-weight: 650; }
QPushButton#bentoCard QLabel#homeDetailLine {
    color: #6C7D8B; font-size: 11px; line-height: 1.35;
}
QPushButton#bentoCard QFrame#homeInfoRow {
    border-radius: 10px; border: 1px solid #DCE9E2;
}
QPushButton#bentoCard QFrame#homeInfoRow[rowTone="mint"] {
    background: #EDF7F1; border-color: #D6E9DE;
}
QPushButton#bentoCard QFrame#homeInfoRow[rowTone="sky"] {
    background: #EEF5F9; border-color: #D8E7EF;
}
QPushButton#bentoCard QFrame#homeInfoRow QLabel#homeInfoRowIcon {
    background: rgba(255,255,255,175); border: 1px solid rgba(185,211,199,150);
    border-radius: 8px;
}
QPushButton#bentoCard QFrame#homeInfoRow QLabel#homeDetailLine {
    color: #425B52; background: transparent; border: none; padding: 0px;
}
QPushButton#bentoCard QFrame#homeStatBlock {
    background: #F4F7F9; border: 1px solid #E0E8ED; border-radius: 11px;
}
QPushButton#bentoCard QLabel#homeStatValue { color: #3F6E8C; font-size: 18px; font-weight: 750; }
QPushButton#bentoCard QLabel#homeStatCaption { color: #8A9AA6; font-size: 10px; }
QPushButton#bentoCard[bentoTone="hero"] {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #F5FAFC,stop:0.55 #EAF3F7,stop:1 #EEF7F3);
    border-color: #D0E1E9;
}
QPushButton#bentoCard[bentoTone="hero"]:hover {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #F5FAFC,stop:0.55 #EAF3F7,stop:1 #EEF7F3);
    border-color: #D0E1E9;
}
QPushButton#bentoCard[bentoTone="green"] { background: #F2F8F4; border-color: #D5E5DB; }
QPushButton#bentoCard[bentoTone="green"]:hover { background: #F2F8F4; border-color: #D5E5DB; }
QPushButton#bentoCard[bentoTone="green"] QLabel#bentoIcon { background: #E2F0E7; border-color: #CDE3D5; }
QPushButton#bentoCard[bentoTone="green"] QLabel#homeBadge { color: #49795F; background: #E2F0E7; border-color: #C7DFD0; }
QPushButton#bentoCard[bentoTone="green"] QLabel#homeStatValue,
QPushButton#bentoCard[bentoTone="green"] QLabel#bentoAction { color: #4F8066; }
QPushButton#bentoCard[bentoTone="power"] {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #F7FBFA,stop:0.58 #EDF7F3,stop:1 #EBF3F7);
    border-color: #CCE0DA;
}
QPushButton#bentoCard[bentoTone="power"]:hover {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #F7FBFA,stop:0.58 #EDF7F3,stop:1 #EBF3F7);
    border-color: #CCE0DA;
}
QPushButton#bentoCard[bentoTone="power"] QLabel#bentoIcon {
    background: #DFF1EA; border-color: #C7E2D8;
}
QPushButton#bentoCard[bentoTone="power"] QLabel#homeBadge {
    color: #39745F; background: #E0F1EA; border-color: #C7E2D6;
}
QPushButton#bentoCard[bentoTone="power"] QLabel#homeStatValue,
QPushButton#bentoCard[bentoTone="power"] QLabel#bentoAction { color: #357B64; }
QPushButton#bentoCard[bentoTone="power"] QLabel#homeStatValue { font-size: 15px; }
QPushButton#bentoCard[bentoTone="amber"] { background: #FFFCF6; border-color: #EAE0CD; }
QPushButton#bentoCard[bentoTone="amber"]:hover { background: #FFFCF6; border-color: #EAE0CD; }
QPushButton#bentoCard[bentoTone="amber"] QLabel#bentoIcon { background: #F6ECD9; border-color: #E8D8B8; }
QLabel#homeFootnote { color: #8B9AA6; font-size: 11px; letter-spacing: 1px; padding-top: 2px; }
QWidget#homeCarousel {
    background: transparent; border: none; border-radius: 20px;
}

/* 充电中：深色能量流舞台 + 交替色实时指标，不使用环形图。 */
QLabel#chargingLiveTitle {
    color: #173F33; font-size: 24px; font-weight: 800; letter-spacing: 1px;
}
QLabel#chargingLiveBadge {
    color: #13764D; background: #DDF3E6; border: 1px solid #BFE2CD;
    border-radius: 11px; padding: 6px 12px; font-size: 10px; font-weight: 800;
}
QWidget#chargingEnergyStage { background: transparent; border: none; }
QFrame#chargingSessionCard {
    background: rgba(255,255,255,222); border: 1px solid #D4E5DC; border-radius: 18px;
}
QLabel#chargingSessionEyebrow {
    color: #4E9071; font-size: 9px; font-weight: 800; letter-spacing: 2px;
}
QLabel#chargingOrderTitle { color: #244739; font-size: 16px; font-weight: 750; line-height: 1.35; }
QFrame#chargingSessionDivider { background: #DDE9E2; border: none; }
QLabel#chargingPriceHint { color: #5E766B; font-size: 11px; line-height: 1.45; }
QLabel#chargingSyncHint { color: #91A098; font-size: 9px; }
QFrame#chargeMetricCard {
    background: rgba(255,255,255,225); border: 1px solid #D9E6DF; border-radius: 15px;
}
QFrame#chargeMetricCard[metricTone="mint"] { background: #EFF8F2; border-color: #D2E7D9; }
QFrame#chargeMetricCard[metricTone="sky"] { background: #EEF6FA; border-color: #D4E6EF; }
QFrame#chargeMetricCard[metricTone="amber"] { background: #FFF8EC; border-color: #EADFCB; }
QLabel#chargeMetricIcon {
    background: rgba(255,255,255,190); border: 1px solid rgba(199,220,208,190); border-radius: 11px;
}
QLabel#chargeMetricCaption { color: #788D83; font-size: 9px; }
QLabel#chargeMetricValue { color: #204F3D; font-size: 19px; font-weight: 800; }
QFrame#chargeChartPanel {
    background: rgba(255,255,255,225); border: 1px solid #D7E5DD; border-radius: 17px;
}
QLabel#chargeChartTitle { color: #254A3B; font-size: 14px; font-weight: 750; }
QPushButton#chargeChartModeButton {
    color: #236B4D; background: #E7F4EC; border: 1px solid #BFDCCB;
    border-radius: 9px; padding: 6px 12px; font-size: 10px; font-weight: 700;
}
QPushButton#chargeChartModeButton:hover { color: #154D35; background: #DCEFE3; border-color: #78AE8C; }
QWidget#chargingActiveView QPushButton#settleBtn {
    min-height: 28px; border-radius: 12px; font-size: 14px; font-weight: 750;
}

/* 管理端首页：与客户端同源的柔和 Bento 表面，尺寸由不规则跨行跨列布局决定。 */
QWidget#adminHomePage, QWidget#adminHomeContent, QScrollArea#adminHomeScroll,
QScrollArea#adminHomeScroll QWidget#qt_scrollarea_viewport { background: transparent; border: none; }
QLabel#adminHomeGreeting { color: #28463B; font-size: 25px; font-weight: 750; }
QLabel#adminHomeIntro { color: #73857C; font-size: 13px; }
QFrame[adminHomeCard="true"] {
    background: #FFFFFF; border: 1px solid #D6E5DC; border-radius: 20px;
}
QFrame#adminHomeHero {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #E2F1E7, stop:0.26 #FFFFFF, stop:0.61 #EDF4E6, stop:1 #CDE2D1);
    border-color: #C6DCCF;
}
QFrame#adminConnectionCard { background: #F6FBF7; border-color: #C7DFD0; }
QFrame#adminTrendCard { background: #FFFFFF; border-color: #DCE8E0; }
QFrame#adminPileCard { background: #F4F8F6; }
QFrame#adminStationCard { background: #FFFCF5; border-color: #E7DDC8; }
QFrame#adminOrderCard { background: #F2F7FA; border-color: #D5E2E9; }
QFrame#adminUserCard { background: #EDF6F0; border-color: #D0E3D6; }
QLabel#adminHomeCardTitle { color: #294A3C; font-size: 17px; font-weight: 750; }
QLabel#adminHomeCardHint { color: #768A80; font-size: 11px; }
QLabel#adminHomeBadge {
    color: #2A6D4C; background: #E1F1E7; border: 1px solid #C7E2D1;
    border-radius: 10px; padding: 5px 10px; font-size: 10px; font-weight: 700;
}
QFrame#adminHomeStat { background: rgba(255,255,255,180); border: 1px solid #DFE9E2; border-radius: 12px; }
QLabel#adminHomeStatValue { color: #2F7655; font-size: 20px; font-weight: 750; }
QLabel#adminHomeStatCaption { color: #819189; font-size: 10px; }
QLabel#adminHomeBigValue { color: #2C6E50; font-size: 28px; font-weight: 750; }
QFrame#adminHomeDataPill {
    background: rgba(255,255,255,165); border: 1px solid rgba(205,224,212,190);
    border-radius: 10px;
}
QLabel#adminHomeDataIcon {
    background: #E2F1E8; border: 1px solid #CAE2D3; border-radius: 8px;
}
QLabel#adminHomeDataValue {
    color: #315F4A; background: transparent; border: none;
    font-size: 12px; font-weight: 700;
}
QLabel#adminHomeDataCaption {
    color: #87978F; background: transparent; border: none; font-size: 9px;
}
QLabel#adminHomeEndpoint { color: #547064; font-size: 11px; }
QLabel#adminHomeFootnote { color: #82948A; font-size: 11px; padding: 4px; }
QWidget#lanConnectionPanel { background: transparent; border: none; }
QLabel#lanStatusBadge {
    color: #246347; background: #DFF0E5; border: 1px solid #C4DDCD;
    border-radius: 10px; padding: 4px 9px; font-size: 10px; font-weight: 700;
}
QFrame#lanPrimaryAddressPanel {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #174A38, stop:0.62 #23684D, stop:1 #32785A);
    border: 1px solid #2A6D51; border-radius: 14px;
}
QLabel#lanAddressEyebrow {
    color: #BEE1CD; background: transparent; border: none;
    font-size: 10px; font-weight: 700; letter-spacing: 1px;
}
QLabel#lanAddressText {
    color: #FFFFFF; background: transparent; border: none;
    padding: 1px 0px; font-size: 21px; font-weight: 750; letter-spacing: 1px;
}
QLabel#lanAddressMeta {
    color: #D5EADF; background: transparent; border: none; font-size: 10px;
}
QFrame#lanPrimaryAddressPanel QPushButton#adminHomeAction {
    color: #174B37; background: rgba(255,255,255,225); border-color: rgba(255,255,255,110);
    padding: 6px 10px;
}
QFrame#lanPrimaryAddressPanel QPushButton#adminHomeAction:hover {
    color: #103C2B; background: #FFFFFF; border-color: #FFFFFF;
}
QLabel#lanOtherAddresses {
    color: #456A58; background: #EDF5F0; border: 1px solid #D4E5DA;
    border-radius: 9px; padding: 7px 10px; font-size: 10px; line-height: 1.35;
}
QFrame#lanLocalAddressPanel {
    background: rgba(255,255,255,145); border: 1px solid #D7E6DC; border-radius: 10px;
}
QLabel#lanLocalCaption {
    color: #7A8E83; background: transparent; border: none; font-size: 10px;
}
QLabel#lanLocalAddress {
    color: #315F49; background: transparent; border: none;
    font-size: 12px; font-weight: 700; letter-spacing: 1px;
}
QPushButton#adminHomeAction {
    color: #356D54; background: rgba(255,255,255,190); border: 1px solid #D0E1D6;
    border-radius: 9px; padding: 7px 11px; font-size: 11px; font-weight: 700;
}
QPushButton#adminHomeAction:hover { color: #174F35; background: #E8F3EC; border-color: #85B497; }
QWidget#adminRevenueChart { background: transparent; border: none; }

/* 账户与通知：个人资料、钱包与卡片式车库。 */
QFrame#accountProfile, QFrame#accountSection, QFrame#vehicleGarage {
    background: white; border: 1px solid #DFEAE4; border-radius: 16px;
}
QLabel#accountTopBadge {
    color: #366D55; background: #E8F3EC; border: 1px solid #D3E7DB;
    border-radius: 11px; padding: 6px 12px; font-size: 11px;
}
QLabel#accountAvatar { background: #EAF5ED; border: 1px solid #D1E6D8; border-radius: 20px; }
QLabel#accountStatus { color: #2E7654; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
QLabel#accountName { color: #193F33; font-size: 22px; font-weight: 700; }
QFrame#accountWallet { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #153F35,stop:.58 #206148,stop:1 #39795C); border: none; border-radius: 16px; }
QLabel#walletCaption { color: #CDE5D6; background: transparent; font-size: 12px; }
QLabel#walletAmount { color: #FFFFFF; background: transparent; font-size: 40px; font-weight: 700; }
QLabel#walletPill { color: #E9F8EF; background: rgba(255,255,255,35); border: 1px solid rgba(255,255,255,45); border-radius: 9px; padding: 4px 8px; font-size: 10px; }
QWidget#accountPage QPushButton { min-height: 22px; }
QWidget#accountPage QLineEdit, QWidget#accountPage QDoubleSpinBox { min-height: 22px; padding: 7px 12px; }
QWidget#accountPage QDoubleSpinBox QLineEdit { min-height: 0px; padding: 0px; border: none; background: transparent; }
QPushButton#amountPreset { background: #F7FAF8; border: 1px solid #DCE7DF; }
QPushButton#amountPreset:checked { background: #E5F3E9; color: #17613F; border: 1px solid #5B9E77; font-weight: 700; }
QPushButton#addVehicleBtn { color: white; background: #1F704E; border: 1px solid #175D40; border-radius: 10px; padding: 8px 15px; font-weight: 700; }
QPushButton#addVehicleBtn:hover { background: #2D805C; }
QFrame#vehicleCard { background: #F7FAF8; border: 1px solid #E1EBE5; border-radius: 13px; }
QFrame#vehicleCard[defaultVehicle="true"] { background: #F2F8F4; border: 1px solid #BFDCCB; }
QLabel#vehicleIcon { color: #EBFFF2; background: #245E49; border: none; border-radius: 17px; min-width: 52px; max-width: 52px; min-height: 52px; max-height: 52px; font-size: 13px; font-weight: 800; letter-spacing: 1px; }
QLabel#vehiclePlate { color: #173D30; font-size: 17px; font-weight: 750; }
QLabel#vehicleDefaultBadge { color: #397054; background: #DDEFE3; border: 1px solid #CBE4D4; border-radius: 8px; padding: 3px 7px; font-size: 10px; }
QLabel#vehicleModel { color: #476458; font-size: 13px; font-weight: 600; }
QLabel#vehicleMeta { color: #84958C; font-size: 11px; }
QLabel#vehicleEmpty { color: #819087; background: #F8FBF9; border: 1px dashed #CADCD1; border-radius: 13px; padding: 24px; min-height: 88px; line-height: 1.6; }
QPushButton#vehicleTextButton, QPushButton#vehicleDeleteButton { background: transparent; border: none; padding: 6px 8px; min-height: 18px; }
QPushButton#vehicleTextButton { color: #397158; }
QPushButton#vehicleTextButton:hover { color: #164B34; background: #E5F1E9; }
QPushButton#vehicleDeleteButton { color: #A65A5E; }
QPushButton#vehicleDeleteButton:hover { color: #8E3D43; background: #F8E9EA; }
QLabel#vehicleDialogTitle { color: #193F33; font-size: 20px; font-weight: 750; }
QLabel#vehicleDialogHint { color: #84928B; font-size: 11px; padding-bottom: 5px; }
QLabel#vehicleFieldLabel { color: #4C6257; font-size: 11px; font-weight: 650; }
QDialog#vehicleEditorDialog QLineEdit, QDialog#vehicleEditorDialog QComboBox,
QDialog#vehicleEditorDialog QDoubleSpinBox { min-height: 24px; }
QLabel#messageSummary { background: #E5F1E9; color: #245E42; border-radius: 12px; padding: 20px; font-size: 18px; font-weight: 600; }
QListWidget#messageList { background: transparent; border: none; padding: 0px; outline: none; }
QListWidget#messageList::item { padding: 0px; margin: 0px; border: none; }
QLabel#messageEmpty { background: white; color: #72867A; border: 1px solid #DFEAE4; border-radius: 16px; font-size: 15px; padding: 24px; }
QComboBox#messageFilter { min-height: 22px; min-width: 130px; }

/* 我的订单：旅程票据。用留白、编号章和横向时间轨迹替代表格。 */
QWidget#orderHistoryPage, QWidget#orderCardsHost, QWidget#reservationCardsHost,
QScrollArea#orderCardScroll { background: transparent; border: none; }
QTabWidget#orderTabs::pane { border: none; background: transparent; }
QTabWidget#orderTabs QTabBar::tab {
    background: transparent; color: #75877E; padding: 10px 18px;
    border: none; border-bottom: 2px solid #DDE8E1;
}
QTabWidget#orderTabs QTabBar::tab:selected {
    color: #174E38; border-bottom: 2px solid #237653; font-weight: 700;
}
QLabel#orderSummary, QLabel#reservationSummary {
    color: #315D49; background: #E8F2EB; border-radius: 10px;
    padding: 10px 14px; font-size: 13px;
}
QFrame#orderJourneyCard {
    background: #FFFFFF; border: 1px solid #DEE9E2; border-left: 4px solid #A9BDB1;
    border-radius: 16px;
}
QFrame#orderJourneyCard[orderState="active"] { border-left-color: #D4A94E; }
QFrame#orderJourneyCard[orderState="done"] { border-left-color: #237653; }
QFrame#orderJourneyCard[orderState="error"] { border-left-color: #BD5961; }
QFrame#orderJourneyCard[newRecord="true"] { border-color: #8DB9E8; border-left-color: #4B91DB; }
QFrame#orderJourneyCard:hover { background: #FCFEFC; border-color: #8DB49D; }
QLabel#orderMarker {
    color: #194D39; background: #E4F1E8; border: 1px solid #D0E4D7;
    border-radius: 18px; min-width: 36px; min-height: 36px;
    max-width: 36px; max-height: 36px; qproperty-alignment: AlignCenter;
    font-size: 13px; font-weight: 700;
}
QLabel#orderStation { color: #193D31; font-size: 17px; font-weight: 700; }
QLabel#orderIdentity { color: #89978F; font-size: 11px; letter-spacing: 1px; }
QLabel#orderStateBadge {
    color: #687A70; background: #F0F3F1; border-radius: 10px;
    padding: 5px 10px; font-size: 12px;
}
QLabel#orderStateBadge[orderState="active"] { color: #906522; background: #FFF3D9; }
QLabel#orderStateBadge[orderState="done"] { color: #1C6848; background: #E5F4E9; }
QLabel#orderStateBadge[orderState="error"] { color: #A34149; background: #FCEAEC; }
QLabel#orderTimeline {
    color: #74867B; background: transparent; border-top: 1px solid #EEF3EF;
    border-bottom: 1px solid #EEF3EF; padding: 9px 2px; font-size: 12px;
}
QFrame#orderMetric { background: #F6F9F7; border: none; border-radius: 11px; }
QFrame#orderMetric[featured="true"] { background: #183F34; }
QLabel#orderMetricCaption { color: #87978E; background: transparent; font-size: 11px; }
QFrame#orderMetric[featured="true"] QLabel#orderMetricCaption { color: #BBD4C6; }
QLabel#orderMetricValue { color: #2C4B3E; background: transparent; font-size: 15px; font-weight: 650; }
QLabel#orderAmount { color: #F5FFF8; background: transparent; font-size: 22px; font-weight: 700; }
QLabel#orderFootnote { color: #8A9991; background: transparent; font-size: 11px; }
QLabel#orderRefund { color: #9A6730; background: #FFF1D9; border-radius: 8px; padding: 5px 9px; }
QPushButton#orderDetailButton {
    color: #215E43; background: transparent; border: none; padding: 5px 2px; font-weight: 700;
}
QPushButton#orderDetailButton:hover { color: #123F2C; background: transparent; }
QPushButton#orderPagerButton { background: transparent; border: 1px solid #DCE7E0; padding: 6px 12px; }
QLabel#orderEmpty {
    color: #7D8D84; background: #FFFFFF; border: 1px dashed #CBDCD1;
    border-radius: 16px; padding: 40px; min-height: 180px;
}
QFrame#reservationTicket {
    background: #FFFFFF; border: 1px solid #DEE9E2; border-radius: 15px;
}
QFrame#reservationTicket[reservationActive="true"] { border-left: 4px solid #D4A94E; }
QLabel#reservationType { color: #1D6547; background: #E7F3EA; border-radius: 8px; padding: 5px 9px; font-size: 11px; }
QLabel#reservationStation { color: #203F34; font-size: 16px; font-weight: 700; }
QLabel#reservationStatus { color: #8D6A2D; background: #FFF3DC; border-radius: 9px; padding: 5px 10px; }
QLabel#reservationStatus[reservationState="done"] { color: #1C6848; background: #E5F4E9; }
QLabel#reservationStatus[reservationState="muted"] { color: #76857D; background: #EEF2EF; }
QLabel#reservationJourney { color: #536B5E; background: #F6F9F7; border-radius: 9px; padding: 12px 14px; }
QPushButton#reservationCancelButton { color: #A0444C; background: transparent; border: none; padding: 5px; }
QPushButton#reservationCancelButton:hover { color: #7D2F36; background: #FCEEEF; }
QFrame#orderReceiptHero {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #173F34,stop:1 #28644E);
    border: none; border-radius: 16px;
}
QLabel#orderReceiptCaption { color: #B8D5C5; background: transparent; font-size: 10px; letter-spacing: 2px; }
QLabel#orderReceiptAmount { color: #FFFFFF; background: transparent; font-size: 34px; font-weight: 700; }
QLabel#orderReceiptStation { color: #D6EADF; background: transparent; font-size: 13px; }
QLabel#orderDetailField {
    color: #28483B; background: #F5F8F6; border: 1px solid #E3ECE6;
    border-radius: 10px; padding: 12px; line-height: 1.5;
}
