/* 企业稳重主题：深藏青 + 暖金 */
QMainWindow, QDialog {
    background: #F3F7F6;
}

QWidget {
    color: #243247;
    font-family: "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

QWidget#sidebar {
    background: #18263D;
    border-right: 1px solid #101B2D;
}

QWidget#logoBox {
    background: #223653;
    border: 1px solid #324A6B;
    border-radius: 8px;
    margin: 10px 12px 8px;
    padding: 10px 8px;
}
QLabel#logoLabel {
    color: #DAFFAE;
    font-size: 16px;
    font-weight: 700;
}

QListWidget#navList {
    background: transparent;
    color: #AEBBD0;
    border: none;
    outline: 0;
    padding: 4px 6px;
    font-size: 14px;
}
QListWidget#navList::item {
    padding: 12px 14px;
    margin: 3px 5px;
    border-radius: 6px;
    border-left: 3px solid transparent;
}
QListWidget#navList::item:hover {
    background: #263A59;
    color: #FFFFFF;
}
QListWidget#navList::item:selected {
    background: #237653;
    color: #FFFFFF;
    border-left: 3px solid #F7E2A9;
    font-weight: 700;
}

QPushButton {
    background: #FFFFFF;
    color: #344257;
    border: 1px solid #CCD4DF;
    border-radius: 6px;
    padding: 8px 16px;
    min-height: 18px;
}
QPushButton:hover { background: #ECF6EF; border-color: #7CAD90; color: #195C3D; }
QPushButton:pressed { background: #DCEFE1; }
QPushButton:disabled { background: #EEF1F5; color: #9AA6B5; border-color: #DCE2EA; }
QPushButton#primaryBtn, QPushButton#addButton, QPushButton#searchButton,
QPushButton#openWebBtn, QPushButton#successBtn {
    background: #237653;
    color: #FFFFFF;
    border: 1px solid #195E42;
    font-weight: 700;
}
QPushButton#primaryBtn:hover, QPushButton#addButton:hover, QPushButton#searchButton:hover,
QPushButton#openWebBtn:hover, QPushButton#successBtn:hover { background: #358661; }
QPushButton#secondaryBtn {
    background: #FFFFFF;
    color: #526176;
    border: 1px solid #CBD3DD;
}
QPushButton#secondaryBtn:hover { background: #ECF6EF; border-color: #7CAD90; color: #195C3D; }
QPushButton#dangerBtn, QPushButton#restartButton, QPushButton#freezeButton, QPushButton#settleBtn {
    background: #FFFFFF;
    color: #A13D45;
    border: 1px solid #DCAEB2;
}
QPushButton#dangerBtn:hover, QPushButton#restartButton:hover, QPushButton#freezeButton:hover,
QPushButton#settleBtn:hover { background: #FCEEEF; border-color: #C97880; }
QPushButton#logoutBtn {
    background: transparent;
    border: 1px solid transparent;
    color: #AEBBD0;
    text-align: left;
    padding: 10px 14px;
}
QPushButton#logoutBtn:hover { background: #263A59; color: #DAFFAE; }

QWidget#headerBar {
    background: #FFFFFF;
    border-bottom: 1px solid #DCE2EA;
}
QLabel#headerTitle { color: #18263D; font-size: 17px; font-weight: 700; }
QLabel#headerUser {
    color: #6B7788;
    background: #F6F7F9;
    border: 1px solid #E1E5EB;
    border-radius: 13px;
    padding: 6px 14px;
}

QLabel#pageTitle { color: #18263D; font-size: 21px; font-weight: 700; padding-bottom: 2px; }
QLabel#pageHint { color: #8290A2; font-size: 12px; }
QLabel#sectionTitle { color: #344257; font-size: 15px; font-weight: 700; }
QLabel#summaryLabel { color: #66758A; background: #FFFFFF; border: 1px solid #E0E5EC; border-radius: 6px; padding: 9px 12px; }

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit {
    background: #FFFFFF;
    color: #243247;
    border: 1px solid #CCD4DF;
    border-radius: 6px;
    padding: 8px 10px;
    selection-background-color: #237653;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus {
    border: 2px solid #7CAD90;
    padding: 7px 9px;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover { border-color: #7CAD90; }
QLineEdit::placeholder { color: #A0AABA; }
QComboBox::drop-down { width: 24px; border: none; }
QComboBox::down-arrow { image: url(:/icons/arrow-down.png); width: 12px; height: 8px; margin-right: 6px; }
QComboBox QAbstractItemView { background: #FFFFFF; border: 1px solid #CCD4DF; selection-background-color: #E2F3E7; selection-color: #18573A; padding: 4px; }

QCheckBox { color: #657286; spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #C4CDD8; border-radius: 4px; background: #FFFFFF; }
QCheckBox::indicator:checked { background: #237653; border-color: #195E42; }

QTableWidget, QTableView {
    background: #FFFFFF;
    alternate-background-color: #F8F9FB;
    color: #344257;
    border: 1px solid #DCE2EA;
    border-radius: 8px;
    gridline-color: #EDF0F4;
    selection-background-color: #E2F3E7;
    selection-color: #18573A;
    outline: 0;
}
QTableWidget::item, QTableView::item { padding: 8px; border: none; }
QTableWidget::item:hover, QTableView::item:hover { background: #FBF7EF; }
QHeaderView::section {
    background: #EEF1F5;
    color: #526176;
    border: none;
    border-right: 1px solid #DCE2EA;
    border-bottom: 1px solid #DCE2EA;
    padding: 10px 8px;
    font-weight: 700;
}
QTableCornerButton::section { background: #EEF1F5; border: none; }

QFrame#metricCard, QFrame#statCard {
    background: #FFFFFF;
    border: 1px solid #DCE2EA;
    border-radius: 9px;
}
QFrame#metricCard:hover, QFrame#statCard:hover { border-color: #7CAD90; }
QLabel#metricTitle { color: #7A8798; font-size: 12px; background: transparent; }
QLabel#metricValue { color: #237653; font-size: 27px; font-weight: 700; background: transparent; }
QWidget#chartHost, QWidget#chartArea, QWidget#detailPanel, QWidget#profileCard { background: #FFFFFF; border: 1px solid #DCE2EA; border-radius: 8px; }
QLabel#avatarLabel { border: 1px solid #C9D2DD; border-radius: 6px; background: #EEF1F5; }
QLabel#phoneLabel { color: #344257; font-size: 16px; font-weight: 700; }
QLabel#balanceLabel { color: #237653; font-size: 15px; font-weight: 700; }
QWidget#mapCanvas { background: #E9EDF2; border: 1px solid #D2DAE4; border-radius: 8px; }
QLabel#navResult {
    color: #18573A;
    background: #FBF4E5;
    border: 1px solid #E7D6AE;
    border-radius: 6px;
    padding: 9px 12px;
}
QLabel#orderLabel { color: #526176; font-size: 14px; }
QLabel#chargingValue { color: #237653; font-size: 22px; font-weight: 700; padding: 2px 0; }
QLabel#minutesLabel { color: #344257; font-size: 14px; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #C3CCD8; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #237653; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #C3CCD8; border-radius: 4px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: #237653; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QStatusBar { background: #FFFFFF; color: #778497; border-top: 1px solid #DCE2EA; }
QSplitter::handle { background: #DCE2EA; }
QSplitter::handle:horizontal { width: 3px; }
QMessageBox { background: #FFFFFF; }
QMessageBox QLabel { color: #344257; }
QToolTip { background: #18263D; color: #FFFFFF; border: 1px solid #7CAD90; padding: 6px 10px; }

/* 管理端数据卡片 */
QFrame#adminDataCard, QWidget#chartArea {
    background: #FFFFFF; border: 1px solid #DDE9E2; border-radius: 14px;
}
QLabel#dataCardTitle { color: #254B38; font-size: 15px; font-weight: 700; background: transparent; }
QLabel#dataCountBadge { color: #4D7D62; background: #ECF5EF; border-radius: 10px; padding: 4px 10px; font-size: 12px; }
QLabel#dataCardHint { color: #88998F; font-size: 11px; background: transparent; padding: 3px 0; }
QFrame#adminDataCard QTableWidget {
    background: #FFFFFF; alternate-background-color: #F7FAF8; border: none;
    selection-background-color: #E0F1E7; selection-color: #214B36; outline: 0;
}
QFrame#adminDataCard QTableWidget::item { border: none; border-bottom: 1px solid #EEF3EF; padding: 8px; }
QFrame#adminDataCard QTableWidget::item:hover { background: #EEF7F1; }
QFrame#adminDataCard QHeaderView::section {
    background: #F0F6F2; color: #64806E; border: none; padding: 10px 8px; font-size: 12px; font-weight: 600;
}
QFrame#metricCard, QFrame#statCard { border: 1px solid #DFEAE3; border-radius: 14px; background: #FFFFFF; }
QFrame#metricCard:hover, QFrame#statCard:hover { border-color: #96BFA7; background: #FBFDFB; }
QWidget#lanConnectionPanel { background: #EAF4EE; border-bottom: 1px solid #D6E7DC; }

/* Shared card surfaces and focus baseline; animated highlights live in UiMotion. */
QFrame#pileCard, QFrame#miniCard, QFrame#stationCard, QWidget#profileCard,
QFrame#adminDataCard, QFrame#metricCard, QFrame#statCard {
    border-radius: 14px;
}
QFrame#pileCard:hover, QFrame#miniCard:hover, QFrame#stationCard:hover,
QFrame#adminDataCard:hover { border-color: #91BFA7; }
QPlainTextEdit:focus { border: 2px solid #7CAD90; }
QWidget#customTitleBar { background: transparent; }
QWidget#customTitleBar QLabel { background: transparent; color: #365747; font-weight: 600; }
QStatusBar { border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; }
