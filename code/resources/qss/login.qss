/* =========================================================
   登录对话框样式(LoginDialog / AdminLoginDialog)
   深蓝科技感渐变背景 + 白色圆角卡片 + 现代输入框
   ========================================================= */

#loginDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                stop:0 #12365C, stop:0.55 #0E2A4A, stop:1 #0A1D33);
}

#titleLabel {
    color: #FFFFFF;
    font-size: 26px;
    font-weight: bold;
    background: transparent;
    letter-spacing: 2px;
}

#subtitleLabel {
    color: rgba(255, 255, 255, 200);
    font-size: 14px;
    background: transparent;
    letter-spacing: 4px;
}

#hintLabel {
    color: rgba(255, 255, 255, 160);
    font-size: 12px;
    background: transparent;
}

#exitBtn {
    color: rgba(255, 255, 255, 180);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    font-size: 12px;
    padding: 6px 16px;
}
#exitBtn:hover {
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.12);
}

/* 白色卡片容器 */
#card {
    background: #FFFFFF;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.35);
}

#cardTitle {
    color: #1F2A3C;
    font-size: 16px;
    font-weight: bold;
    background: transparent;
}

QTabWidget {
    background: transparent;
}
QTabWidget::pane {
    border: none;
    background: #FFFFFF;
    border-radius: 14px;
    top: 2px;
}
QTabBar {
    background: transparent;
}
QTabBar::tab {
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 210);
    padding: 9px 30px;
    margin-right: 8px;
    font-size: 14px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}
QTabBar::tab:hover { background: rgba(255, 255, 255, 0.14); }
QTabBar::tab:selected {
    background: #FFFFFF;
    color: #2F80ED;
    font-weight: bold;
}

QLineEdit {
    background: #F7FAFC;
    border: 1px solid #DCE4EE;
    border-radius: 9px;
    padding: 11px 14px;
    font-size: 14px;
    color: #22303E;
    selection-background-color: #2F80ED;
    selection-color: #FFFFFF;
}
QLineEdit:focus {
    border: 2px solid #2F80ED;
    background: #FFFFFF;
    padding: 10px 13px;
}

QPushButton#userLoginBtn, QPushButton#adminLoginBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #2F80ED, stop:1 #00B8A9);
    color: #FFFFFF;
    border: none;
    border-radius: 9px;
    padding: 12px 16px;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 2px;
}
QPushButton#userLoginBtn:hover, QPushButton#adminLoginBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #2A76E0, stop:1 #00A696);
}
QPushButton#userLoginBtn:pressed, QPushButton#adminLoginBtn:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #2568C8, stop:1 #009383);
}

#tipLabel {
    color: #8A97A6;
    font-size: 12px;
    background: transparent;
}

#fieldLabel {
    color: #475569;
    font-size: 13px;
    font-weight: bold;
    background: transparent;
}

QCheckBox {
    color: #5A6B7E;
    font-size: 13px;
    background: transparent;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #C4CFDB;
    border-radius: 4px;
    background: #FFFFFF;
}
QCheckBox::indicator:hover { border-color: #2F80ED; }
QCheckBox::indicator:checked {
    background: #2F80ED;
    border: 1px solid #2F80ED;
}
