/* 登录对话框主题：统一浅绿背景、深绿品牌色与白色登录卡片 */

#loginDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                stop:0 #F3F7F6, stop:0.55 #EDF6F0, stop:1 #E2F1E7);
}

#titleLabel {
    color: #174F3B;
    font-size: 28px;
    font-weight: bold;
    background: transparent;
    letter-spacing: 2px;
}

#subtitleLabel {
    color: #5C7C6B;
    font-size: 14px;
    background: transparent;
    letter-spacing: 1px;
}

#hintLabel {
    color: #708478;
    font-size: 12px;
    background: transparent;
}

#exitBtn {
    color: #557361;
    background: #FFFFFF;
    border: 1px solid #D3E4D8;
    border-radius: 7px;
    font-size: 12px;
    padding: 6px 16px;
}
#exitBtn:hover {
    color: #174F3B;
    background: #E3F3E8;
    border-color: #83B496;
}

#card {
    background: #FFFFFF;
    border-radius: 12px;
    border: 1px solid #DAE8DF;
}

#cardTitle {
    color: #243E33;
    font-size: 16px;
    font-weight: bold;
    background: transparent;
}

QLineEdit {
    background: #F6FAF7;
    border: 1px solid #D3E1D8;
    border-radius: 8px;
    padding: 11px 14px;
    font-size: 14px;
    color: #243E33;
    selection-background-color: #237653;
    selection-color: #FFFFFF;
}
QLineEdit:focus {
    border: 2px solid #6DA385;
    background: #FFFFFF;
    padding: 10px 13px;
}
QLineEdit::placeholder { color: #A0AABA; }

QPushButton#userLoginBtn, QPushButton#adminLoginBtn {
    background: #237653;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 3px;
}
QPushButton#userLoginBtn:hover, QPushButton#adminLoginBtn:hover { background: #2D8660; }
QPushButton#userLoginBtn:pressed, QPushButton#adminLoginBtn:pressed { background: #195E42; }

#tipLabel {
    color: #6B8173;
    font-size: 12px;
    background: transparent;
}

#fieldLabel {
    color: #456451;
    font-size: 13px;
    font-weight: bold;
    background: transparent;
}

QCheckBox {
    color: #587362;
    font-size: 13px;
    background: transparent;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #C5D8CB;
    border-radius: 4px;
    background: #FFFFFF;
}
QCheckBox::indicator:checked {
    background: #237653;
    border-color: #195E42;
}

QLabel#loginMark { background: #DDF0E4; border: 1px solid #C8E2D1; border-radius: 14px; padding: 10px; }
QPushButton#userLoginBtn:focus, QPushButton#adminLoginBtn:focus { border: 2px solid #85BB99; }

#serverLabel { color: #456451; font-size: 13px; }
#connectionStatus { color: #456451; font-size: 12px; }
QSpinBox { background: #F6FAF7; color: #243E33; border: 1px solid #D3E1D8; border-radius: 6px; padding: 10px 6px; min-width: 74px; }
#connectBtn { background: #E3F3E8; color: #174F3B; border: 1px solid #83B496; border-radius: 7px; padding: 8px; }
#connectBtn:disabled { color: #708478; background: #EDF1EE; }
