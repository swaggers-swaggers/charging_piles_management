/* 登录对话框主题：企业稳重风，深藏青背景 + 暖金强调 + 白色卡片 */

#loginDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                stop:0 #1B2A42, stop:0.55 #142139, stop:1 #0E1930);
}

#titleLabel {
    color: #F4D99B;
    font-size: 25px;
    font-weight: bold;
    background: transparent;
    letter-spacing: 2px;
}

#subtitleLabel {
    color: rgba(244, 217, 155, 210);
    font-size: 14px;
    background: transparent;
    letter-spacing: 5px;
}

#hintLabel {
    color: rgba(216, 224, 238, 170);
    font-size: 12px;
    background: transparent;
}

#exitBtn {
    color: rgba(226, 233, 244, 200);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 7px;
    font-size: 12px;
    padding: 6px 16px;
}
#exitBtn:hover {
    color: #F4D99B;
    background: rgba(244, 217, 155, 0.14);
    border-color: #C5A66F;
}

#card {
    background: #FFFFFF;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.4);
}

#cardTitle {
    color: #243247;
    font-size: 16px;
    font-weight: bold;
    background: transparent;
}

QLineEdit {
    background: #F8F9FB;
    border: 1px solid #D6DDE7;
    border-radius: 8px;
    padding: 11px 14px;
    font-size: 14px;
    color: #243247;
    selection-background-color: #A9864F;
    selection-color: #FFFFFF;
}
QLineEdit:focus {
    border: 2px solid #B9975B;
    background: #FFFFFF;
    padding: 10px 13px;
}
QLineEdit::placeholder { color: #A0AABA; }

QPushButton#userLoginBtn, QPushButton#adminLoginBtn {
    background: #A9864F;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 3px;
}
QPushButton#userLoginBtn:hover, QPushButton#adminLoginBtn:hover { background: #B9955B; }
QPushButton#userLoginBtn:pressed, QPushButton#adminLoginBtn:pressed { background: #967443; }

#tipLabel {
    color: #8B96A6;
    font-size: 12px;
    background: transparent;
}

#fieldLabel {
    color: #526176;
    font-size: 13px;
    font-weight: bold;
    background: transparent;
}

QCheckBox {
    color: #657286;
    font-size: 13px;
    background: transparent;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #C4CDD8;
    border-radius: 4px;
    background: #FFFFFF;
}
QCheckBox::indicator:checked {
    background: #A9864F;
    border-color: #967443;
}
