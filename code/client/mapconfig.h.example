// 腾讯地图 WebService API 配置模板
//
// 使用步骤:
//   1) 复制本文件为 mapconfig.h
//   2) 把下面 "YOUR_KEY" 替换成你在腾讯位置服务控制台申请的 Key
//   3) 保持 mapconfig.h 不被提交到 Git(已在 .gitignore 中忽略)
//
// 注意: 请勿把真实 Key 直接写进 mapconfig.h.example 或提交到公共仓库。

#ifndef MAPCONFIG_H
#define MAPCONFIG_H

#define TENCENT_MAP_KEY "YOUR_KEY"

#endif // MAPCONFIG_H
