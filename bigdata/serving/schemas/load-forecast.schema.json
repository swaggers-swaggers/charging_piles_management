{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "station_id",
      "model",
      "model_version",
      "metrics",
      "origin",
      "recent_backtest",
      "direct_horizons",
      "points"
    ],
    "properties": {
      "station_id": {
        "type": "integer"
      },
      "model": {
        "enum": [
          "hour",
          "day",
          "week",
          "8week",
          "global",
          "station",
          "shared_gbt",
          "residual_cnn"
        ]
      },
      "model_version": {
        "type": "string"
      },
      "metrics": {
        "$ref": "#/$defs/metrics"
      },
      "recent_backtest": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "time",
            "actual_kwh",
            "predicted_kwh"
          ]
        }
      },
      "direct_horizons": {
        "type": "object",
        "required": [
          "1",
          "6",
          "24"
        ],
        "properties": {
          "1": {
            "$ref": "#/$defs/direct"
          },
          "6": {
            "$ref": "#/$defs/direct"
          },
          "24": {
            "$ref": "#/$defs/direct"
          }
        }
      },
      "points": {
        "type": "array",
        "minItems": 24,
        "maxItems": 24,
        "items": {
          "type": "object",
          "required": [
            "horizon",
            "time",
            "load_kwh",
            "lower_kwh",
            "upper_kwh",
            "idle",
            "queue",
            "alert"
          ],
          "properties": {
            "horizon": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24
            },
            "time": {
              "type": "string"
            },
            "load_kwh": {
              "type": "number",
              "minimum": 0
            },
            "lower_kwh": {
              "type": "number",
              "minimum": 0
            },
            "upper_kwh": {
              "type": "number",
              "minimum": 0
            },
            "idle": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "queue": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "alert": {
              "enum": [
                "normal",
                "peak"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "metrics": {
      "type": "object",
      "required": [
        "n",
        "mae",
        "rmse",
        "wmape"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "mae": {
          "type": "number",
          "minimum": 0
        },
        "rmse": {
          "type": "number",
          "minimum": 0
        },
        "wmape": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "direct": {
      "type": "object",
      "required": [
        "model",
        "prediction_kwh",
        "metrics",
        "baseline_metrics",
        "improvement"
      ],
      "properties": {
        "model": {
          "enum": [
            "shared_gbt",
            "residual_cnn",
            "8week"
          ]
        },
        "prediction_kwh": {
          "type": "number",
          "minimum": 0
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "baseline_metrics": {
          "$ref": "#/$defs/metrics"
        },
        "improvement": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
